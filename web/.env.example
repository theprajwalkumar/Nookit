# Nookit checkout links.
# Use the hosted checkout URL for each licence size (Dodo Payments, Paddle,
# Lemon Squeezy, Stripe Payment Links — whichever you use).
# If unset, the Buy buttons fall back to a pre-filled sales email.
NEXT_PUBLIC_CHECKOUT_1=
NEXT_PUBLIC_CHECKOUT_3=
NEXT_PUBLIC_CHECKOUT_5=

# Optional: canonical site URL, used by metadata and the sitemap.
NEXT_PUBLIC_SITE_URL=https://nookit.app
